<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>順番待ち受付システム</title>
  <style>
    :root {
      --primary: #1e3a8a;
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text: #0f172a;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 20px;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
    }
    h1, h2 {
      text-align: center;
      color: var(--primary);
    }
    .card {
      background: var(--card-bg);
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
      margin-bottom: 20px;
    }
    .input-group {
      display: flex;
      gap: 10px;
      margin-bottom: 15px;
    }
    input[type="text"], input[type="number"] {
      flex: 1;
      padding: 10px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 16px;
    }
    button {
      padding: 10px 16px;
      background-color: var(--primary);
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 16px;
      font-weight: bold;
    }
    button.btn-danger {
      background-color: #dc2626;
    }
    .status-box {
      text-align: center;
      padding: 15px;
      background-color: #eff6ff;
      border-radius: 8px;
    }
    .status-number {
      font-size: 36px;
      font-weight: bold;
      color: var(--primary);
    }
    ul {
      list-style: none;
      padding: 0;
    }
    li {
      padding: 12px;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    li:first-child {
      font-weight: bold;
      background-color: #f1f5f9;
      border-radius: 6px;
    }
  </style>
</head>
<body>

<div class="container">
  <h1>✂️ 床屋の順番待ち</h1>

  <!-- お客様用：受付フォーム -->
  <div class="card">
    <h2>受付（順番待ち登録）</h2>
    <div class="input-group">
      <input type="text" id="userName" placeholder="お名前を入力してください">
      <button onclick="registerName()">登録</button>
    </div>
  </div>

  <!-- お客様用：現在の全体状況 -->
  <div class="card">
    <h2>現在の案内状況</h2>
    <div class="status-box">
      <div>現在の待ち人数</div>
      <div class="status-number" id="totalWaiting">0 人</div>
      <div>およその待ち時間: <span id="estimatedTime" style="font-weight: bold;">0</span> 分</div>
    </div>
  </div>

  <!-- 店員用：管理パネル -->
  <div class="card">
    <h2>【店員用】管理画面</h2>
    <div class="input-group">
      <label style="line-height: 40px;">1人あたりの目安時間(分):</label>
      <input type="number" id="timePerPerson" value="20" min="1" style="max-width: 80px;" onchange="updateUI()">
    </div>
    <button class="btn-danger" style="width: 100%; margin-bottom: 15px;" onclick="nextCustomer()">1人施術完了（先頭を消去）</button>
    
    <h3>現在の待ちリスト</h3>
    <ul id="waitingList"></ul>
  </div>
</div>

<script>
  // ローカルストレージからデータを読み込み、無ければ初期化
  let queue = JSON.parse(localStorage.getItem('barberQueue')) || [];

  function saveData() {
    localStorage.setItem('barberQueue', JSON.stringify(queue));
  }

  // 順番登録
  function registerName() {
    const input = document.getElementById('userName');
    const name = input.value.trim();
    if (!name) {
      alert('お名前を入力してください');
      return;
    }
    queue.push(name);
    input.value = '';
    saveData();
    updateUI();
  }

  // 先頭の1人を完了処理
  function nextCustomer() {
    if (queue.length === 0) {
      alert('待っているお客様はいません');
      return;
    }
    const finishedUser = queue.shift();
    alert(`${finishedUser} さんの案内・施術完了`);
    saveData();
    updateUI();
  }

  // 画面の更新処理
  function updateUI() {
    const timePerPerson = parseInt(document.getElementById('timePerPerson').value) || 20;
    
    // 待ち人数と予想時間の更新
    document.getElementById('totalWaiting').textContent = `${queue.length} 人`;
    document.getElementById('estimatedTime').textContent = queue.length * timePerPerson;

    // リストの描画
    const listElement = document.getElementById('waitingList');
    listElement.innerHTML = '';
    
    if (queue.length === 0) {
      listElement.innerHTML = '<li>現在待ちなし</li>';
      return;
    }

    queue.forEach((name, index) => {
      const li = document.createElement('li');
      const waitMinutes = index * timePerPerson;
      li.textContent = `${index + 1}番目: ${name} 様 （あと約 ${waitMinutes} 分）`;
      listElement.appendChild(li);
    });
  }

  // 初期描画
  updateUI();
</script>

</body>
</html>
